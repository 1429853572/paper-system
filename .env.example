# paper-system 环境配置（由 install.sh 自动生成并随机化敏感项；请勿提交到 git）
# ---- 系统级密钥（install.sh 自动生成） ----
SECRET_KEY=changeme-session-signing-secret
FERNET_KEY=changeme-fernet-master-key
ADMIN_INITIAL_PASSWORD=changeme-initial-admin-password
# CLI 调用 API 的 admin token（install.sh 随机化；手装请自行设置一串随机字符）
PAPERSYS_API_TOKEN=changeme-cli-token

# app/caddy 带 profiles: ["app"]，缺失此行 `docker compose up -d` 不会启动它们
COMPOSE_PROFILES=app

# 宿主 PDF 渲染服务鉴权（install.sh 自动随机化；render-service 与 app 共享）
PAPERSYS_RENDER_TOKEN=changeme-render-token

# ---- 可选：公共额度池（默认关闭；在管理页开启后未配key的成员可用以下key） ----
# POOL_API_BASE=https://open.bigmodel.cn/api/anthropic
# POOL_API_KEY=
# POOL_MODEL=glm-4.7

# ---- 仅 psys 本地提示用（改端口需同时改 compose.yml 与 caddy/Caddyfile） ----
WEB_PORT=7861

# ---- 期刊分区数据源（可选）----
# 中科院分区/JCR/影响因子经 easyScholar 聚合，免费注册获取 key：https://www.easyscholar.cc
# EASYSCHOLAR_KEY=
# EASYSCHOLAR_URL=https://www.easyscholar.cc/open/getRank

# ---- 元数据校准数据源（可选，缺省时匿名限流） ----
# Semantic Scholar（arXiv→S2→CrossRef 校准链的第二环）
# S2_API_KEY=
