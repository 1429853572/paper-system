# paper-system 反代（局域网 http；公网 HTTPS 时在此改站点地址即可）
{
	admin off   # 全局选项：不暴露 Caddy 管理端点（:2019）
}

# 局域网名字访问 http://papers.local（80 口，免端口号）+ IP:7861 直连，同一后端
http://papers.local, :7861 {
	encode gzip
	reverse_proxy app:8001 {
		# SSE 流式进度/问答必需：禁用缓冲
		flush_interval -1
	}
}

# Cloudflare Tunnel 专用入口（compose 未发布此端口——仅容器网内 cloudflared 可达，
# frp/局域网路径够不到，客户端伪造不了 CF-* 头）。
# 登录限速取 XFF 最后一跳当真实客户端：此处用 CF 边缘注入的 CF-Connecting-IP
# 重写 XFF，令 tunnel 路径与局域网路径同样拿到真实 IP（CF 会剥掉客户端自带的 CF-* 头，不可伪造）。
:7863 {
	encode gzip
	reverse_proxy app:8001 {
		flush_interval -1   # SSE 流式必需（tunnel 路径同样要过 caddy 这层）
		header_up X-Forwarded-For "{header.CF-Connecting-IP}"
	}
}
